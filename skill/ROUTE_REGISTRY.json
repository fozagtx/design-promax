{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "design-promax-route-registry",
  "version": "2.6.0",
  "description": "Machine-readable template router + style presets. Paths relative to skill/sources/. Always apply default style preset after routing.",
  "protocol": {
    "before_write_ui": [
      "write_or_read_project_DESIGN_md",
      "fast_keyword_index",
      "load_route_entry",
      "select_style_preset",
      "efficient_merge_core_plus_one_shell",
      "read_merged_files_cap_4",
      "apply_button_matrix_and_compose_recipe",
      "apply_quality_bar_and_case_study_if_clean_product"
    ],
    "max_primary_reads": 4,
    "prefer_extension": ".tsx",
    "sources_root": "sources",
    "style_presets_file": "STYLE_PRESETS.json",
    "default_style_preset": "clean_product",
    "style_merge": "Union route.primary with style.must_read, prefer .tsx, preserve route files first, then style must_read not already included, hard cap 4. Secondary only if still missing atoms.",
    "case_studies_dir": "case-studies",
    "efficient_merge": "IF style in (clean_product, trust_green, clean_product_compact): files = STYLE_PRESETS.efficient_read.clean_product_core (3). IF route needs shell (see shell_apps): append exactly one App.tsx. Cap 4. Surface H: core only (3). ELSE: style.must_read then at most one shell App. Cap 4."
  },
